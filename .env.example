# ============================================================
# AI Automated Security Engineer - Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# ─────────────────────────────────────────────
# Core Application
# ─────────────────────────────────────────────
ENVIRONMENT=production
PORT=8443
VERSION=1.0.0
SECRET_KEY=change-this-to-a-long-random-secret-key-min-64-chars
JWT_SECRET=change-this-to-another-long-random-secret-key-min-64-chars
JWT_EXPIRE_MINUTES=60
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.example.com
CORS_ORIGINS=https://your-domain.example.com

# ─────────────────────────────────────────────
# Database (PostgreSQL + TimescaleDB)
# ─────────────────────────────────────────────
POSTGRES_PASSWORD=change-this-strong-database-password
DATABASE_URL=postgresql+asyncpg://aase:change-this-strong-database-password@postgres:5432/aase_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# ─────────────────────────────────────────────
# Cache & Queue (Redis)
# ─────────────────────────────────────────────
REDIS_PASSWORD=change-this-strong-redis-password
REDIS_URL=redis://:change-this-strong-redis-password@redis:6379/0
CELERY_BROKER_URL=redis://:change-this-strong-redis-password@redis:6379/1
CELERY_RESULT_BACKEND=redis://:change-this-strong-redis-password@redis:6379/2

# ─────────────────────────────────────────────
# SIEM / Elasticsearch
# ─────────────────────────────────────────────
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=change-this-elasticsearch-password
ELASTICSEARCH_INDEX_PREFIX=aase
LOG_RETENTION_DAYS=365

# ─────────────────────────────────────────────
# Self-Hosted AI Models (Ollama)
# No data leaves your environment
# ─────────────────────────────────────────────
OLLAMA_BASE_URL=http://ollama:11434
DEFAULT_LLM_MODEL=llama3.1:70b
FALLBACK_LLM_MODEL=mistral:7b
EMBEDDING_MODEL=nomic-embed-text
CODE_ANALYSIS_MODEL=codellama:34b
PRELOAD_AI_MODELS=true
AI_TRIAGE_ENABLED=true
AI_COMPLIANCE_ANALYSIS=true
ANOMALY_THRESHOLD=0.85
ACTIVE_MODELS=llama3.1:70b,mistral:7b

# ─────────────────────────────────────────────
# Monitoring
# ─────────────────────────────────────────────
GRAFANA_PASSWORD=change-this-grafana-password
PROMETHEUS_URL=http://prometheus:9090

# ─────────────────────────────────────────────
# AWS Integration
# Use IAM Role (preferred) or access keys (least privilege)
# Required IAM permissions documented in integrations/aws/aws_client.py
# ─────────────────────────────────────────────
AWS_DEFAULT_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
# Preferred: Use IAM Role (leave keys blank)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: Cross-account role for scanning
AWS_SCANNER_ROLE_ARN=arn:aws:iam::123456789012:role/AASE-SecurityScanner

# ─────────────────────────────────────────────
# Microsoft Azure Integration
# ─────────────────────────────────────────────
AZURE_TENANT_ID=your-tenant-id-here
AZURE_CLIENT_ID=your-app-registration-client-id
AZURE_CLIENT_SECRET=your-app-registration-client-secret
AZURE_SUBSCRIPTION_ID=your-subscription-id

# ─────────────────────────────────────────────
# Google Cloud Platform Integration
# ─────────────────────────────────────────────
GCP_PROJECT_ID=your-gcp-project-id
# Path to service account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=/app/config/gcp-service-account.json

# ─────────────────────────────────────────────
# LDAP / Active Directory
# ─────────────────────────────────────────────
LDAP_SERVER=ldap://your-domain-controller:389
LDAP_BIND_DN=CN=AASE-Service,OU=Service Accounts,DC=example,DC=com
LDAP_BIND_PASSWORD=change-this-ldap-service-account-password
LDAP_SEARCH_BASE=DC=example,DC=com
LDAP_USE_SSL=true

# ─────────────────────────────────────────────
# JIRA Integration
# ─────────────────────────────────────────────
JIRA_URL=https://your-org.atlassian.net
JIRA_USERNAME=your-jira-email@example.com
JIRA_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=SEC
JIRA_VULN_ISSUE_TYPE=Vulnerability
JIRA_INCIDENT_ISSUE_TYPE=Incident

# ─────────────────────────────────────────────
# PagerDuty Integration
# ─────────────────────────────────────────────
PAGERDUTY_API_KEY=your-pagerduty-api-key
PAGERDUTY_SERVICE_ID=your-pagerduty-service-id
PAGERDUTY_FROM_EMAIL=aase@your-org.com
PAGERDUTY_CRITICAL_SEVERITY_THRESHOLD=critical
PAGERDUTY_HIGH_SEVERITY_THRESHOLD=high

# ─────────────────────────────────────────────
# Slack Integration
# ─────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_SECURITY_CHANNEL=#security-alerts
SLACK_CRITICAL_CHANNEL=#critical-incidents
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token

# ─────────────────────────────────────────────
# Microsoft Teams
# ─────────────────────────────────────────────
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/your-webhook-url

# ─────────────────────────────────────────────
# Email Notifications (SMTP)
# ─────────────────────────────────────────────
SMTP_HOST=smtp.your-mail-server.com
SMTP_PORT=587
SMTP_USERNAME=aase-notifications@your-org.com
SMTP_PASSWORD=change-this-smtp-password
SMTP_USE_TLS=true
SECURITY_TEAM_EMAIL=security-team@your-org.com
CISO_EMAIL=ciso@your-org.com

# ─────────────────────────────────────────────
# Scan Configuration
# ─────────────────────────────────────────────
MAX_CONCURRENT_SCANS=10
SCAN_TIMEOUT_SECONDS=3600
ALLOW_LOCALHOST_SCAN=false
NETWORK_SCAN_RATE_LIMIT=1000
ENABLE_ACTIVE_SCANNING=true
ENABLE_PASSIVE_MONITORING=true
SCHEDULED_SCAN_INTERVAL_HOURS=24

# ─────────────────────────────────────────────
# CVE Database
# ─────────────────────────────────────────────
CVE_DB_PATH=/app/data/cve_database
CVE_UPDATE_SCHEDULE=0 2 * * *
NVD_API_KEY=your-nvd-api-key-for-faster-updates

# ─────────────────────────────────────────────
# Threat Intelligence Feeds
# ─────────────────────────────────────────────
THREAT_INTEL_UPDATE_HOURS=6
ALIENVAULT_OTX_API_KEY=your-alienvault-otx-api-key
VIRUSTOTAL_API_KEY=your-virustotal-api-key
MISP_URL=https://your-misp-instance.example.com
MISP_API_KEY=your-misp-api-key

# ─────────────────────────────────────────────
# Compliance Configuration
# ─────────────────────────────────────────────
ENABLED_FRAMEWORKS=pci_dss_v4,hipaa,soc2_type_ii,iso_27001_2022,nist_csf_2,cis_controls_v8
COMPLIANCE_SCAN_SCHEDULE=0 1 * * 0
COMPLIANCE_REPORT_FORMAT=pdf,json
AUTO_REMEDIATION_ENABLED=false

# ─────────────────────────────────────────────
# Incident Response
# ─────────────────────────────────────────────
AUTO_ISOLATE_ON_RANSOMWARE=true
AUTO_BLOCK_BRUTE_FORCE_IPS=true
AUTO_TICKET_CREATION=true
INCIDENT_ESCALATION_MINUTES=30
PLAYBOOK_DIRECTORY=/app/incident_response/playbooks

# ─────────────────────────────────────────────
# Data Protection
# ─────────────────────────────────────────────
ENCRYPTION_KEY=change-this-to-32-byte-encryption-key-base64
DATA_MASKING_ENABLED=true
AUDIT_LOG_ENCRYPTION=true
SENSITIVE_DATA_PATTERNS=SSN,CREDIT_CARD,PHI

# ─────────────────────────────────────────────
# TLS Configuration
# ─────────────────────────────────────────────
TLS_CERT_PATH=/app/certs/server.crt
TLS_KEY_PATH=/app/certs/server.key
TLS_MIN_VERSION=TLSv1.2
TLS_CIPHER_SUITES=ECDHE-RSA-AES256-GCM-SHA384:ECDHE-RSA-AES128-GCM-SHA256

# ─────────────────────────────────────────────
# Banking/Financial Specific
# (For banks, SWIFT, PCI-DSS environments)
# ─────────────────────────────────────────────
SWIFT_BIC=YOURBANK
PCI_CDE_NETWORKS=10.0.1.0/24,10.0.2.0/24
BANKING_COMPLIANCE_MODE=true
FRAUD_DETECTION_ENABLED=true
TRANSACTION_MONITORING_ENABLED=true
