# ============================================================
# AI Automated Security Engineer - .gitignore
# ============================================================

# CRITICAL: Never commit these
.env
.env.local
.env.production
*.pem
*.key
*.crt
certs/

# Secrets and credentials
secrets/
*credentials*
*secret*
*api_key*
config/gcp-service-account.json

# AI Models (too large for git)
models/
*.gguf
*.bin
*.safetensors

# Data and databases
data/cve_database/
data/threat_intel/
*.db
*.sqlite

# Logs and reports
logs/
reports/
*.log

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
venv/
.venv/
env/
.env/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Docker
docker-compose.override.yml

# Backups
backups/
*.backup
*.bak

# Temporary files
tmp/
temp/
*.tmp
